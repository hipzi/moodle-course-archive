<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/archive/db"
      VERSION="2025113000"
      COMMENT="XMLDB file for local_archive plugin"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">

    <TABLES>

        <TABLE NAME="local_archive_job" COMMENT="Archive job records">
            <FIELDS>
                <FIELD NAME="id"           TYPE="int"    LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="jobid"        TYPE="char"   LENGTH="32" NOTNULL="true"/>
                <FIELD NAME="courseid"     TYPE="int"    LENGTH="10" NOTNULL="true"/>
                <FIELD NAME="userid"       TYPE="int"    LENGTH="10" NOTNULL="true"/>
                <FIELD NAME="priority"     TYPE="char"   LENGTH="10" NOTNULL="true"/>
                <FIELD NAME="size_mb"      TYPE="number" LENGTH="10" DECIMALS="2" NOTNULL="false"/>
                <FIELD NAME="status"       TYPE="char"   LENGTH="20" NOTNULL="true" DEFAULT="queued"/>
                <FIELD NAME="retries"      TYPE="int"    LENGTH="3"  NOTNULL="true" DEFAULT="0"/>
                <FIELD NAME="timecreated"  TYPE="int"    LENGTH="10" NOTNULL="true"/>
                <FIELD NAME="timemodified" TYPE="int"    LENGTH="10" NOTNULL="true"/>
                <FIELD NAME="filepath"     TYPE="text"   NOTNULL="false"/>
            </FIELDS>

            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>

            <INDEXES>
                <INDEX NAME="jobid_idx"    UNIQUE="true"  FIELDS="jobid"/>
                <INDEX NAME="courseid_idx" UNIQUE="false" FIELDS="courseid"/>
                <INDEX NAME="userid_idx"   UNIQUE="false" FIELDS="userid"/>
                <INDEX NAME="status_idx"   UNIQUE="false" FIELDS="status"/>
            </INDEXES>
        </TABLE>

    </TABLES>
</XMLDB>
